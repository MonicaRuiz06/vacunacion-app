# Copia este archivo como .env y completa los valores. .env no se sube a Git.
# Una línea vacía (CLAVE=) cuenta como no definida.

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Correo saliente con Brevo (https://www.brevo.com), por SMTP. Obligatorio en
# producción; en desarrollo, sin MAIL_SERVER los correos se muestran en la terminal.
# Pasos y detalles en el README, sección «Avisos y correo».
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=1
# "Login" de la página SMTP & API de Brevo (termina en @smtp-brevo.com).
MAIL_USERNAME=
# Clave SMTP de Brevo (empieza por xsmtpsib-); no es la contraseña de la cuenta.
MAIL_PASSWORD=
# Remitente: obligatorio. Debe ser un correo verificado en Brevo (Senders),
# p. ej. Vacunación <vacunacion.usc@gmail.com>.
MAIL_FROM=
