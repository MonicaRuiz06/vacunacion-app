# Copia este archivo como .env y completa los valores. .env no se sube a Git.
# Una línea vacía (CLAVE=) cuenta como no definida.

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Correo saliente (opcional). Sin MAIL_SERVER los correos se muestran en la terminal.
# Con Gmail: activa la verificación en dos pasos y crea una "contraseña de
# aplicación" (16 caracteres); esa va en MAIL_PASSWORD, no la contraseña normal.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente que verá el destinatario; si se deja vacío se usa MAIL_USERNAME.
MAIL_FROM=
